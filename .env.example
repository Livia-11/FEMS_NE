# =============================================
# TZW LTD - Fire Extinguisher Management System
# Environment Configuration Template
#
# INSTRUCTIONS:
#   cp .env.example .env
#   Fill in real values before running.
#   NEVER commit .env to version control.
# =============================================

# ── Application Environment ──────────────────
# development | production
# Controls: error verbosity, OTP/token visibility in API responses, logging format
NODE_ENV=development

# ── CORS ─────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production set this to your actual domain (e.g. https://fems.tzwltd.com)
# Use '*' only for fully public APIs (not recommended for this system).
CORS_ORIGIN=http://localhost:5173

# ── JWT ──────────────────────────────────────
# Minimum 32 characters. Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Internal Service Communication ───────────
# Key used for service-to-service calls (e.g. extinguisher → notification)
# Change this in production — weak keys allow unauthorized internal requests
INTERNAL_SERVICE_KEY=internal_service_key_change_in_production

# ── Service Ports ────────────────────────────
GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
EXTINGUISHER_SERVICE_PORT=3002
REPORTING_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004

# ── Service URLs (inter-service communication) ──
USER_SERVICE_URL=http://localhost:3001
EXTINGUISHER_SERVICE_URL=http://localhost:3002
REPORTING_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004

# ── PostgreSQL ───────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_postgres_password
PG_USER_DB=fems
PG_EXTINGUISHER_DB=fems
PG_NOTIFICATION_DB=fems

# ── Email / SMTP (optional) ──────────────────
# If not configured, OTPs and reset tokens are returned in API responses (dev mode only).
# For production, configure a real SMTP server or transactional email service.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_not_your_gmail_password
FROM_EMAIL=noreply@tzwltd.com
FROM_NAME=TZW LTD Fire Safety

# ── Default Admin Account ────────────────────
# Created automatically on first run of the user-service.
# Change these immediately after first login.
DEFAULT_ADMIN_EMAIL=admin@tzwltd.com
DEFAULT_ADMIN_PASSWORD=Admin@123456

# ── OTP Settings ─────────────────────────────
OTP_EXPIRES_MINUTES=10
